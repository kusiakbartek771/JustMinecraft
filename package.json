{
  "name": "justlauncher",
  "productName": "JustLauncher",
  "version": "1.0.0",
  "description": "JustLauncher – launcher Minecrafta do modów: Vanilla, Fabric, Quilt, Forge i NeoForge, mody / resource packi / shadery / datapacki z Modrinth, paczki z Google Drive i integracja z JustMusic.",
  "main": "src/main/main.js",
  "author": "JustLauncher contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test:install": "node scripts/test-install.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "release": "electron-builder --publish always",
    "test:content": "node scripts/test-content.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.justlauncher.minecraft",
    "productName": "JustLauncher",
    "copyright": "JustLauncher contributors",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "justmusic-plugin/**/*",
      "packs/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JustLauncher",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Game",
      "icon": "assets/icon.png",
      "maintainer": "JustLauncher contributors <noreply@github.com>",
      "desktop": {
        "entry": {
          "StartupWMClass": "JustLauncher"
        }
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kusiakbartek771",
        "repo": "JustLauncher",
        "releaseType": "release"
      }
    ]
  },
  "desktopName": "justlauncher.desktop",
  "justlauncher": {
    "repo": "kusiakbartek771/JustLauncher",
    "msClientId": "",
    "packsUrl": "https://raw.githubusercontent.com/kusiakbartek771/JustLauncher/main/packs/packs.json",
    "issuesUrl": "https://github.com/kusiakbartek771/JustLauncher/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kusiakbartek771/JustLauncher.git"
  },
  "homepage": "https://github.com/kusiakbartek771/JustLauncher"
}
